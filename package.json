{
  "name": "planner-2026",
  "version": "2.0.0",
  "private": true,
  "description": "Bộ 4 Sheets 2026 — Planner 90 ngày (MỤC TIÊU → HÀNH ĐỘNG → KẾT QUẢ). Static SPA + Vercel Function đồng bộ qua Upstash Redis.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./public/css/tailwind.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./public/css/tailwind.css --watch",
    "dev": "node scripts/dev-server.mjs",
    "bundle": "node scripts/bundle.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=18"
  }
}
